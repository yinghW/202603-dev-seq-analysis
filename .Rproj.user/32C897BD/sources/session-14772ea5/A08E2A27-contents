# a set of functions that calculate the linear distance of measurement in Mnemiopsis
# PA

# argument: matrix that contain every landmark from each image
# return an array containing the measurement from each image

# PA axis (v.2)

# The oral side auricle length (from the connecting point to lobe, oral side)
ALO_fun <- function(mat)
{
  dist = 0
  # calculate the distance between each landmark that are included in the measurement 
  x <- c(mat[1, 1], mat[2, 1])
  y <- c(mat[1, 2], mat[2, 2])
  dist = sqrt((x[1]-x[2])^2 + (y[1]-y[2])^2)
  
  return(dist)
}

