# makes a list of all .csv files that contain landmark data
files <- list.files("D:/202509-dev-seq/20C-202509-dev-seq/lm", 
                    pattern = "*.csv", 
                    full.names = TRUE, 
                    recursive = TRUE)

# 2. Read into a named list
# .x = .x names the list elements by the file path automatically
data_list <- files %>% 
  set_names() %>% 
  map(read_csv)

# 3. Optional: Merge into ONE data frame with a 'source' column
# This is often why people want the directory names!
combined_data <- data_list %>% 
  bind_rows(.id = "file_origin")

#path <- combined_data$file_origin[1]
#matches <- str_match(path, "lm/([^/]+)/([^/]+)/0905")

combined_data <- combined_data %>%
  separate_wider_regex(
    cols = file_origin,
    patterns = c(
      ".*/",                # Skip everything until the last slash before the target folder
      temp = "\\d+",      # Capture digits before 'C' (e.g., '20')
      "C-",                 # Match literal 'C-'
      biorep = "[^/]+",     # Capture everything until the next slash (e.g., '202509-dev-seq')
      "/lm/",               # Match literal '/lm/'
      ind = "[^/]+",     # Capture folder 1 (e.g., '11')
      "/",                
      # Match literal '/'
      plane = "[^/]+",     # Capture folder 2 (e.g., 'OA')
      "/\\d{4}.*"           # Match 4-digit folder and discard the rest
    ),
    cols_remove = FALSE    # Keeps the original path column
  )

# convert the X and Y coordinates to micron using the pixel to micron record
convert_df <- read.csv("2025-mag-pixel-to-micron-record.csv")

# --- 1. Clean Dataframe 1 (Long Paths) ---
# D:/.../lm/11/OA/0905-OA-2.csv  ->  11/OA/0905-OA-2.csv
combined_data_cleaned <- combined_data %>%
  mutate(
    # Regex logic: 
    # Find a slash followed by digits (\\d+)
    # Then a slash and any uppercase letters ([A-Z]+)
    # Then the rest of the string (.*)
    join_key = str_extract(file_origin, "\\d+/[A-Z]+/.*\\.csv$")
  )

# --- 2. Clean Dataframe 2 (Short Paths) ---
