### Import each plane
Import PA (data has one less column than the other)
```{r}
# makes a list of all .csv files that contain landmark data
filelist <- list.files(path = PA_dir[1],
                         recursive = TRUE,
                         pattern = "\\.csv") 

# create a new matrix to take in the information 
coords = NULL 

# prep the directory of the data
filelist_path <- paste(PA_dir[1], filelist, sep="")

# loop through all the file and read each csv file, only retrieved the x and y coordinates
for (i in 1:length(filelist)){
  para <- read.table(filelist_path[i], header = TRUE, sep = ",")
  col <- ncol(read.table(filelist_path[i], header = TRUE, sep = ","))
  tmp <- as.matrix(read.table(filelist_path[i], header = TRUE, sep = ",", colClasses = c(rep("NULL",col-2), "numeric","numeric")))
  coords <- rbind(coords, tmp)
  #print(filelist_path[i])
}

# transform the PAcoords to the arrayspecs format
coords <- arrayspecs(coords, PAlm, 2)

PA <- list(
  stage = as.factor(c(rep("L", 20))),
  quality = as.factor(c(rep("B", 10), rep("G", 10))),
  equipment = as.factor(c(rep("nikon", 20))),
  coords = coords
)

#closeAllConnections()
```

