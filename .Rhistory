#df_NoLA[,39:51]
df_test <-df_gmm_export[,20:32] %>%
mutate (stage = df_gmm_export$stage) %>%
dplyr::select(-c("sd_BL"))
lda.stg <-lda(stage ~ ., data = df_test)
lda.stg
# Extract scaling matrix and compute absolute coefficients
df_coefs <- as.data.frame(lda.stg$scaling) %>%
tibble::rownames_to_column(var = "Feature") %>%
mutate(
# Create absolute values for sorting importance
Abs_LD1 = abs(LD1)
)
lda_con <- ggplot(df_coefs, aes(x = reorder(Feature, Abs_LD1), y = LD1, fill = LD1 > 0)) +
geom_col(show.legend = FALSE, width = 0.6) +
coord_flip() +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
lda_con
ggsave(file="/Volumes/Yinghui/202603-dev-seq-analysis/fig/lda_contribution.svg", plot=lda_con)
stg.sub <-
df_test[1:12]%>%
as.matrix  # cast to matrix for calculations
# calculate CV scores
CVA.scores <- stg.sub %*% lda.stg$scaling
# create data frame with scores
stg.CV <- data.frame(CVA.scores)
stg.CV$stage <- df_test$stage
cva.plot <-
ggplot(stg.CV, aes(x = LD1, y = LD2)) +
geom_point(aes(color=stage, shape=stage), alpha=0.7) +
labs(x = "CV1", y = "CV2") +
coord_fixed(ratio=1)  # keep the unit scaling of the plot fixed at 1
cva.plot
lda_plot <-  ggplot(stg.CV, aes(x = LD1, y = LD2)) +
geom_point(aes(color=stage), alpha=0.7) +
coord_fixed(ratio=1)+
theme_classic()# keep the unit scaling of the plot fixed at 1
lda_plot
ggsave(file="/Volumes/Yinghui/202603-dev-seq-analysis/fig/lda_plot.svg", plot=lda_plot)
ggplot(stg.CV, aes(x = LD1)) +
geom_density(aes(color=stage)) +
labs(x = "CV1")
