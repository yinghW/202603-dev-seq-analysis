library("geomorph")
library("dplyr")
options(rgl.useNULL=TRUE)
library("rgl")
library("tidyverse")
library("gtools")
library(lubridate)
library(gridExtra)
library(factoextra)
library(ggplot2)
library(clustvarsel)
library(mclust)
library(ggpubr)
library(svglite)
library(MASS)
df_lm <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lm.rds")
df_lmw <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lmw.rds")
df_iso <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_iso.rds")
#df_NoLA_6.4 <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_NoLA.rds")
#df_NoLA <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_NoLA.rds")
df_gmm_export <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_gmm_export.rds")
#df_NoLA <- df_iso %>%
#  dplyr::select(-c("ALO", "AW", "LTM", "LL", "sd_LL","sd_LTM","sd_ALO","sd_AW"))%>%
#  drop_na() %>%
#  filter(if_all(where(is.numeric),  ~ is.finite(.x) & .x != 0))
#filter(if_all(where(is.numeric), is.finite))
#df_NoLA[,7:19]
#df_NoLA[,20:32], lm standardized by volume and logged
#df_NoLA[,39:51]
#df_gmm_export[,20:32]
df_test <-df_gmm_export[,20:32] %>%
mutate (stage = df_gmm_export$stage) %>%
dplyr::select(-c("sd_BL"))
lda.stg <-lda(stage ~ ., data = df_test)
lda.stg
# Extract scaling matrix and compute absolute coefficients
df_coefs <- as.data.frame(lda.stg$scaling) %>%
tibble::rownames_to_column(var = "Feature") %>%
mutate(
# Create absolute values for sorting importance
Abs_LD1 = abs(LD1)
)
lda_con <- ggplot(df_coefs, aes(x = reorder(Feature, Abs_LD1), y = LD1, fill = LD1 > 0)) +
geom_col(show.legend = FALSE, width = 0.6) +
scale_fill_manual(values = palette4) +
coord_flip() +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
lda_con
ggsave(file="/Volumes/Yinghui/202603-dev-seq-analysis/fig/lda_contribution.svg", plot=lda_con)
stg.sub <-
df_test[1:12]%>%
as.matrix  # cast to matrix for calculations
# calculate CV scores
