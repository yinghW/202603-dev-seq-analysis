# Create a matrix of your shape variables
shape_matrix <- df_iso %>%
select(starts_with("shape_")) %>%
as.matrix()
# Add the centroid back to a clean modeling data frame
model_data <- data.frame(
centroid = df_iso$centroid,
shape_matrix
)
# Fit the multivariate linear model
# We typically log-transform the centroid for allometric studies
fit <- lm(shape_matrix ~ lcentroid, data = model_data)
# Create a matrix of your shape variables
shape_matrix <- df_iso %>%
select(starts_with("shape_")) %>%
as.matrix()
# Add the centroid back to a clean modeling data frame
model_data <- data.frame(
centroid = df_iso$centroid,
shape_matrix
)
# Fit the multivariate linear model
# We typically log-transform the centroid for allometric studies
fit <- lm(shape_matrix ~ centroid, data = model_data)
# View the results
summary(fit)
# Multivariate Analysis of Variance
manova_result <- manova(fit)
summary(manova_result, test = "Pillai")
