library("geomorph")
library("dplyr")
options(rgl.useNULL=TRUE)
library("rgl")
library("tidyverse")
library("gtools")
library(lubridate)
library(gridExtra)
library(factoextra)
library(ggplot2)
library(clustvarsel)
library(mclust)
library(ggpubr)
library(svglite)
library(randomForest)
df_lm <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lm.rds")
df_lmw <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lmw.rds")
df_iso <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_iso.rds")
df_gmm_export <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_gmm_export.rds")
data(iris)
# split data
set.seed(42)
trainIndex <- sample(1:nrow(iris), 0.8 * nrow(iris))
trainData <- iris[trainIndex, ]
testData <- iris[-trainIndex, ]
# train model
rf_model <- randomForest(Species ~ ., data = trainData)
print(rf_model)
library(caret)
predictions <- predict(rf_model, testData)
confusionMatrix(predictions, testData$Species)
# Hyperparameter Tuning
#ntree: The number of trees to grow in the forest. A higher number of trees usually results in better performance.
#mtry: The number of features to consider for each split. Tuning this parameter can help achieve a better balance between bias and variance.
rf_tuned <- randomForest(Species ~ ., data = trainData, ntree = 500, mtry = 2)
print(rf_tuned)
importance(rf_model)
varImpPlot(rf_model)
df_gmm_export[,21:33]
df_gmm_export[,20:32]
View(df_gmm_export)
df_gmm_export[,c(20:32,34:35)]
