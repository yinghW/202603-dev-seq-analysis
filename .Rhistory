#### For simplicity, we'll use the Workspace saved from the previous analyses
#### So we don't have to re-import data
#### We will also use the geometric morphometric data
#### But the same type of analyses
#### can be performed with other multidimensional phenotypes
load(".RData")
##########################################################
### We start with relative warps in size-shape space  ####
##########################################################
ShapeANDsize=cbind(Shape_fish_matrix, log(Specimen_info$CS))
#### For simplicity, we'll use the Workspace saved from the previous analyses
#### So we don't have to re-import data
## NOTE saving workspaces is usually not recommended
## You may export results from previous scripts for instance
## as RDS files or similar
load(".RData")
library(Morpho)
Location=as.factor(c(rep("ANAB", 4), rep("ANCD", 13), rep("CAS1", 7), rep("CAS2", 9)))
# For this practical, I'm also creating a new factor with location
# so that more than two groups are available
# I'm pooling multiple locations so that there are multiple individuals in one group
#######################
##### First CVA #######
#######################
CVA_River=CVA(Shape_fish_3Darray, Specimen_info$River, weighting = TRUE,
plot = TRUE, rounds = 1000, cv = TRUE)
### This script is for those who are following the R part of the practicals
### it imports geometric morphometric data,
### performs a Generalized Procrustes Analysis
### (with sliding of semilandmarks in one of the datasets)
### and saves the workspace which can then be used downstream
### for the actual analyses explained in the Multidimensional Phenotypic Evolution course
library(Morpho)
library(geomorph)
Raw_data_fish=readland.tps(file = "brown_trout2.TPS",
specID = "imageID")
oa_shape <- gpaOA$coords
oa_size <- log(gpaOA$Csize)
ShapeOnSize=lm(oa_shape~oa_size)
oa_shape <- gpaOA$coords
oa_size <- log(gpaOA$Csize)
ShapeOnSize <- lm(oa_shape ~ oa_size)
length(oa_shape)
length(oa_size)
