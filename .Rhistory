shapes <- tails$shapes
spp <- tails$data$species
wf <- tails$links
phy <- tails$tree
# Generate morphospace
mspace(shapes, links = wf, cex.ldm = 5)
View(tails)
shapes
class(shapes)
View(tails)
tails[["links"]][[1]]
