geom_line(aes(y = seg_preds5), color = "#343434", size = 1) + # Piecewise regression line
geom_vline(xintercept = m5_breaking_point, linetype = "dashed", color = "#343434", size = 0.8) +
#annotate("text", x = m5_breaking_point + 0.1, y = 9, label = "Transition Point", hjust = 0, color = "red") +
theme_classic() +
theme(axis.title.x = element_blank(),
axis.text.x = element_blank(),
axis.ticks.x = element_blank())
pp10 <- ggplot(df_gmm_export, aes(x = BL, y = TABW, color = stage)) +
#geom_point(color = "#3880ba", alpha = 0.8) +                # Scatter plot of raw data
geom_point()+
scale_color_manual(values = palette4)+
geom_line(aes(y = seg_preds5), color = "#343434", size = 1) + # Piecewise regression line
geom_vline(xintercept = m5_breaking_point, linetype = "dashed", color = "#343434", size = 0.8) +
theme_classic()
pp9_10 <- ggarrange(pp9,pp10,ncol = 1, nrow = 2,align = "v")
ggsave(file="/Volumes/Yinghui/202603-dev-seq-analysis/fig/PABW_vs_BL_piecewise_regression.svg", plot=pp9_10)
