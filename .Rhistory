df_lmw_nolog <- df_lm %>%
select(-c(plane, log_value)) %>%
group_by(sample_id, ind) %>%
pivot_wider(
names_from = measure_name,
values_from = value
)
df_LA <- df_lmw_nolog[,5:18]
measure_cols <- colnames(df_LA)
df_iso <- df_lmw_nolog %>%
ungroup() %>%
mutate(centroid = exp(mean(log(select(., TBL:TABW), na.rm = TRUE)))) %>%
ungroup() %>%
mutate(across(all_of(measure_cols),
~ .x - centroid,
.names = "shape_{.col}"))
