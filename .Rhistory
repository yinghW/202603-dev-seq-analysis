gpaTA_2 <- gpagen(ta_final_points)
shapes <- gpaTA_2$coords
#stage <- df_NoLA$stage
#lks <- list(c(13,3,4), c(10,5), c(8,9), c(5,3))
lks <- list(c(1,4,5), c(6,7), c(2,3), c(4,6))
# Generate morphospace
mspace(shapes, groups = stage, links = lks, cex.ldm = 5)
# Get mean shapes of each stage
stg_shapes <- expected_shapes(shapes = shapes, x = stage)
# Generate morphospace and project:
msp <- mspace(shapes = shapes, links = lks, cex.ldm = 5) %>%
# scatter points
proj_shapes(shapes = shapes, col = stage) %>%
# convex hulls enclosing groups
proj_groups(shapes = shapes, groups = stage, alpha = 0.5)
