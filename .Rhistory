}
}
# 5. Bind into one large dataframe
df_lm <- bind_rows(measurement_accumulator)
df_lm <- df_lm %>% mutate(
# Convert from microns (or current unit) to mm
value = value / 1000
)
df_lm <- df_lm %>%
mutate(value = case_when(
# Rule for LTM (Threshold 0.05)
measure_name == "LTM"  & value < 0.05 ~ NA_real_,
# Rule for ALO, AW, LL (Threshold 0.07)
measure_name %in% c("ALO", "AW","LL") & value < 0.07 ~ NA_real_,
# Keep everything else as is
TRUE ~ value
))
df_lm <- df_lm %>%
group_by(sample_id, ind, temp,biorep) %>%
mutate(ltm_is_na = any(measure_name == "LTM" & is.na(value)),
value = case_when(measure_name == "LL"  & ltm_is_na ~ NA_real_,
# Keep everything else as is
TRUE ~ value))%>%
dplyr::select(-ltm_is_na)%>%
ungroup()
df_lm <- df_lm %>%
group_by(sample_id, ind, temp,biorep) %>%
mutate(ll_is_na = any(measure_name == "LL" & is.na(value)),
value = case_when(measure_name == "LTM"  & ll_is_na ~ NA_real_,
# Keep everything else as is
TRUE ~ value))%>%
dplyr::select(-ll_is_na)%>%
ungroup()
df_lm <- df_lm %>%
mutate(date_obj = parse_date_time(paste0(sample_id, "2025"), orders = "mdy")) %>%
group_by(biorep) %>%
mutate(exp_day = as.numeric(difftime(date_obj, min(date_obj), units = "days")+1)) %>%
ungroup()
# dplyr::select(-c(date_obj))
df_lm <- df_lm  %>%
mutate(sample_id = paste(ind, temp, biorep, sep = "-"))
#create a new column with log value
df_lm <- df_lm %>% mutate(log_value = log(value))
df_lmw <- df_lm %>%
dplyr::select(-c(plane, log_value)) %>%
group_by(sample_id, ind) %>%
pivot_wider(
names_from = measure_name,
values_from = value
)
# previous version: using estimated volume as estimation of size
#df_lmw <- df_lmw %>%
#  mutate(vol = (2 *(TABW/2) * (PABW/2)*BL*pi )/3)
# standardize the body size through body length
measure_cols <- colnames(df_lmw[,7:23])
df_iso <-  df_lmw  %>%
mutate(across(all_of(measure_cols),
~ .x/BL,
.names = "sd_{.col}"))
df_pt <- read.csv("/Volumes/Yinghui/202603-dev-seq-analysis/data/202509-10-dev-tentacle.csv",header = TRUE)
df_pt <- df_pt %>% dplyr::select(c("sample_id","exp_day","tentacle"))
df_iso <- left_join(df_iso, df_pt, by = c("sample_id","exp_day"))
df_iso <- df_iso %>%
mutate(stage = case_when(
is.na(ALO) & is.na(LL)  ~ "cydippid",
is.na(ALO) & !is.na(LL) ~ "early_transition",
!is.na(ALO) & !is.na(LL) & tentacle == TRUE ~ "late_transition",
!is.na(ALO) & !is.na(LL) & tentacle == FALSE ~ "lobate",
TRUE                     ~ "unclassified"
))
saveRDS(df_lm, file = "/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lm.rds" )
saveRDS(df_lmw, file = "/Volumes/Yinghui/202603-dev-seq-analysis/data/df_lmw.rds" )
saveRDS(df_iso, file = "/Volumes/Yinghui/202603-dev-seq-analysis/data/df_iso.rds")
knitr::opts_chunk$set(echo = TRUE)
#knitr::opts_knit$set(root.dir = "D:/202512-dev-seq-analyses/")
