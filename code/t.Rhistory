library(ggalluvial)
df_iso <- df_iso %>%
mutate(stage = case_when(
is.na(ALO) & is.na(LL)  ~ "cydippid",
is.na(ALO) & !is.na(LL) ~ "early_transition",
!is.na(ALO) & !is.na(LL) ~ "late_transition",
TRUE                     ~ "unclassified"
))
df_NoLA <- df_iso %>% ungroup()%>%
dplyr::select(-c("ALO", "AW", "LTM", "LL","shape_LL","shape_LTM","shape_ALO","shape_AW"))%>%
drop_na()%>%
filter(across(where(is.numeric), is.finite))
df_NoLA$cluster <- as.factor(mod2$classification)
ggplot(df_NoLA, aes(x = log(centroid), y = log(TABW), color = cluster)) +
labs(x = "Log of body length (mm)",y = "log of body width (mm)")+
geom_point(size = 1) +
theme_classic()
#scale_color_manual(values = c("#343434","#ccc9c1","#a4cdee","#3880ba"))
g_plot <- ggplot(df_NoLA,
aes(axis1 = cluster, axis2 = stage, y = ..count..)) +
geom_alluvium(aes(fill = cluster)) +
geom_stratum() +
theme_classic() +
labs(x = "Classification Method",
y = "Number of images")
#scale_fill_manual(values = c("#343434","#3880ba","#a4cdee"))
g_plot
#ggsave(file="D:/202603-dev-seq-analysis/fig/ggalluvial.svg", plot=g_plot)
ggplot(df_NoLA, aes(x = log(centroid), y = log(TABW), color = cluster)) +
labs(x = "Log of body length (mm)",y = "log of body width (mm)")+
geom_point(size = 1) +
theme_classic()
#scale_color_manual(values = c("#343434","#ccc9c1","#a4cdee","#3880ba"))
library(segmented)
df_NoLA <- df_NoLA %>%
mutate(
log_TBL = log(TBL),
log_centroid = log(centroid)
)
model1 <- lm(log_TBL ~ log_centroid, data = df_NoLA)
segmented_model1 <- segmented(model1, seg.Z = ~log_centroid)
df_NoLA$seg_preds1 <- predict(segmented_model1)
pp1 <- ggplot(df_NoLA, aes(x = log_centroid, y = log_TBL, color = cluster)) +
#geom_point(color = "#3880ba", alpha = 0.8) +                # Scatter plot of raw data
geom_line(aes(y = seg_preds1), color = "#343434", size = 1) + # Piecewise regression line
theme_classic() +
geom_point()
df_NoLA <- df_NoLA %>%
mutate(
log_TATB = log(TATB),
log_centroid = log(centroid)
)
model1 <- lm(log_TATB ~ log_centroid, data = df_NoLA)
segmented_model1 <- segmented(model1, seg.Z = ~log_centroid)
# getting slope and breakpoint
segmented_model1$psi
slope(segmented_model1)
df_NoLA$seg_preds1 <- predict(segmented_model1)
pp1 <- ggplot(df_NoLA, aes(x = log_centroid, y = log_TATB, color = stage)) +
#geom_point(color = c("#A3CEF1","#3880ba","#343434"), alpha = 0.8) +                # Scatter plot of raw data
geom_line(aes(y = seg_preds1), color = "#343434", size = 1) + # Piecewise regression line
theme_classic() +
geom_point()+
scale_color_manual(values = c("cydippid" = "#a4cdee",
"early_transition" = "#3880ba",
"late_transition" = "#343434"))
#ggsave(file="/Volumes/Yinghui/202603-dev-seq-analysis/fig/tatb_vs_centroid.svg", plot=pp1)
#ggsave(file="D:/202603-dev-seq-analysis/fig/tatb_vs_centroid.svg", plot=pp1)
