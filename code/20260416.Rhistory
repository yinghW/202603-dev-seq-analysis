dplyr::select(-c("ALO", "AW", "LTM", "LL","shape_LL","shape_LTM","shape_ALO","shape_AW"))%>%
drop_na()%>%
filter(across(where(is.numeric), is.finite)) %>%
df_ori <- df_NoLA[,7:19]
