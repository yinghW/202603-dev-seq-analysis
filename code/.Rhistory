## This script is part of Supplementary materials for manuscript 'Building and
## depicting multivariate ordinations of shape data in R with morphospace' by
## Milla Carmona PS, Lehman OER, Deakin WJ, Soto EM & Soto IM
# load packages
library(morphospace)
library(geomorph)
library(Morpho)
library(Momocs)
library(phytools)
library(RColorBrewer)
library(viridisLite)
## Figure 2 ####################################################################
#Panel A -----------------------------------------------------------------------
# load data
data("shells")
out <- shells$shapes$coe
sp <- shells$data$species
bz <- shells$data$zone
age <- shells$data$age *-1
size <- log(shells$sizes)
# generate colors
palette(viridis(n = 4, option = "D", end = .9))
# generate PCA morphospace, project empirical shapes and confidence ellipses
mspace(out, nh = 8, nv = 6, size.models = 1.5, bg.model = "light gray") %>%
proj_shapes(shapes = out, col = sp) %>%
proj_groups(shapes = out, groups = sp, alpha = 0.4, ellipse = TRUE)
# remove allometric variation for each species
d_out <- out * 0
for(i in 1:nlevels(sp)) {
index <- which(sp == levels(sp)[i])
mod <- lm(out[index,] ~ size[index])
d_out[index,] <- detrend_shapes(mod,
xvalue = max(size[index]),
method = "residuals")
}
# get bgPCA
bgpca <- bg_prcomp(x = d_out, groups = sp)
# generate bgPCA morphospace with detrended shapes; project shapes and ellipses
mspace(ord = bgpca, datype = "fcoef", nh = 8, nv = 6, size.models = 1.5,
bg.model = "light gray", invax = c(1,2)) %>%
proj_shapes(shapes = d_out, col = sp) %>%
proj_groups(shapes = d_out, groups = sp, alpha = 0.4, ellipse = TRUE)
View(shells)
