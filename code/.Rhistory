source("data_import.R")
source("PA_measurement.R")
source("TA_measurement.R")
source("OA_measurement.R")
library("geomorph")
library("dplyr")
options(rgl.useNULL=TRUE)
library("rgl")
library("tidyverse")
library("gtools")
library(lubridate)
library(gridExtra)
library(factoextra)
library(ggplot2)
library(clustvarsel)
library(mclust)
library(ggpubr)
library(svglite)
# df <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/202510-dev-seq-v6.rds")
#df <- readRDS("D:/202603-dev-seq-analysis/data/202510-dev-seq-v6.rds")
#files <- c("D:/202603-dev-seq-analysis/data/202510-dev-seq-v6.rds", "D:/202603-dev-seq-analysis/data/202509-dev-seq-v6.rds")
files <- c("/Volumes/Yinghui/202603-dev-seq-analysis/data/202510-dev-seq-v6.rds", "/Volumes/Yinghui/202603-dev-seq-analysis/data/202509-dev-seq-v6.rds")
df <- lapply(files, readRDS) %>% bind_rows()
df_NoLA <- readRDS("/Volumes/Yinghui/202603-dev-seq-analysis/data/df_NoLA.rds")
df <- df %>%
mutate(
date_string = str_extract(basename(file), "^\\d{4}"),
date_obj = ymd(paste0("2025", date_string))
) %>%
select(-date_string)
df_matched <- inner_join(
df,
df_NoLA,
by = c("date_obj", "temp", "ind","biorep")
)
# convert the lm to matrix for each file.
specs_list <- df_matched %>%
group_by(temp, biorep, ind, plane, file) %>%
group_map(~ {
id <- .y$file
# Create a sub-list for this specific identifier
spec <- list(
matrix = as.matrix(.x[, c("X", "Y")]),
metadata = as.list(.y)
)
setNames(list(spec), id)
}) %>%
flatten()
# add lm 13 in the TA plane
specs_list<-add_lm13(specs_list)
oa_idx <- sapply(specs_list, function(x) {
x$metadata$plane == "OA"
})
# Filter the list to keep only those specimens
oa_list <- specs_list[oa_idx]
# Extract just the 'matrix' part from every list element
# This creates a list of 2D matrices
oa_m <- lapply(oa_list, function(x) x$matrix)
# Combine them into a 3D Array
# Dimensions will be [Landmarks, Coordinates, Specimens]
# In your case: [8, 2, n]
oa_3d_array <- simplify2array(oa_m)
# (Optional) Assign specimen names to the 3rd dimension for tracking
# dimnames(oa_3d_array)[[3]] <- names(format_filtered)
# Check the final structure
dim(oa_3d_array)
gpaOA <- gpagen(oa_3d_array)
plotAllSpecimens(gpaOA$coords)
PCA_OA <- gm.prcomp(gpaOA$coords)
plot(PCA_OA)
library(Morpho)
CVA_stage=CVA(gpaOA$coords, df_NoLA$stage, weighting = TRUE,
plot = TRUE, rounds = 1000, cv = TRUE)
CVA_stage
stage <- as.factor(df_NoLA$stage)
plot(CVA_stage$CVscores[,1], CVA_stage$CVscores[,2], asp = 1,
col = stage,
xlab = "CV1", ylab = "CV2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
bwgPCA_stage=groupPCA(gpaOA$coords, stage, rounds = 10000, cv = TRUE, weighting = FALSE)
plot(bwgPCA_stage$Scores[,1],bwgPCA_stage$Scores[,2], col=stage, asp=1, xlab="bwgPC 1",ylab="bwgPC 2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
bwgPCA_stage$groupdists
bwgPCA_stage$probs
ShapeANDsize <- cbind(gpaOA$coords, log(gpaOA$Csize))
PCASizeShape <- prcomp(ShapeANDsize)
plot(PCASizeShape$x[,1],PCASizeShape$x[,2],
col= stage,
xlab="RW in size-shape space 1",ylab="RW in size-shape space 2",asp = 1)
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
oa_shape <- gpaOA$coords
oa_size <- log(gpaOA$Csize)
# can refer back to lm part 3
ShapeOnSize <- lm(oa_shape ~ oa_size)
ta_idx <- sapply(specs_list, function(x) {
x$metadata$plane == "TA"
})
# Filter the list to keep only those specimens
ta_list <- specs_list[ta_idx]
# Extract just the 'matrix' part from every list element
# This creates a list of 2D matrices
ta_m <- lapply(ta_list, function(x) x$matrix)
# Combine them into a 3D Array
# Dimensions will be [Landmarks, Coordinates, Specimens]
# In your case: [8, 2, n]
ta_3d_array <- simplify2array(ta_m)
# (Optional) Assign specimen names to the 3rd dimension for tracking
# dimnames(oa_3d_array)[[3]] <- names(format_filtered)
# Check the final structure
dim(ta_3d_array)
CVA_stage=CVA(gpaTA$coords, df_NoLA$stage, weighting = TRUE,
plot = TRUE, rounds = 1000, cv = TRUE)
gpaTA <- gpagen(ta_3d_array)
plotAllSpecimens(gpaTA$coords)
CVA_stage=CVA(gpaTA$coords, df_NoLA$stage, weighting = TRUE,
plot = TRUE, rounds = 1000, cv = TRUE)
CVA_stage
stage <- as.factor(df_NoLA$stage)
plot(CVA_stage$CVscores[,1], CVA_stage$CVscores[,2], asp = 1,
col = stage,
xlab = "CV1", ylab = "CV2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
PCA_TA <- gm.prcomp(gpaTA$coords)
plot(PCA_TA)
bwgPCA_stage=groupPCA(gpaTA$coords, stage, rounds = 10000, cv = TRUE, weighting = FALSE)
plot(bwgPCA_stage$Scores[,1],bwgPCA_stage$Scores[,2], col=stage, asp=1, xlab="bwgPC 1",ylab="bwgPC 2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
ShapeANDsize <- cbind(gpaTA$coords, log(gpaTA$Csize))
PCASizeShape <- prcomp(ShapeANDsize)
plot(PCASizeShape$x[,1],PCASizeShape$x[,2],
col= stage,
xlab="RW in size-shape space 1",ylab="RW in size-shape space 2",asp = 1)
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
pa_idx <- sapply(specs_list, function(x) {
x$metadata$plane == "PA"
})
# Filter the list to keep only those specimens
pa_list <- specs_list[pa_idx]
# Extract just the 'matrix' part from every list element
# This creates a list of 2D matrices
pa_m <- lapply(pa_list, function(x) x$matrix)
# Combine them into a 3D Array
# Dimensions will be [Landmarks, Coordinates, Specimens]
# In your case: [8, 2, n]
pa_3d_array <- simplify2array(pa_m)
# (Optional) Assign specimen names to the 3rd dimension for tracking
# dimnames(oa_3d_array)[[3]] <- names(format_filtered)
# Check the final structure
dim(pa_3d_array)
gpaPA <- gpagen(pa_3d_array)
plotAllSpecimens(gpaPA$coords)
CVA_stage=CVA(gpaPA$coords, df_NoLA$stage, weighting = TRUE,
plot = TRUE, rounds = 1000, cv = TRUE)
CVA_stage
stage <- as.factor(df_NoLA$stage)
plot(CVA_stage$CVscores[,1], CVA_stage$CVscores[,2], asp = 1,
col = stage,
xlab = "CV1", ylab = "CV2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
bwgPCA_stage=groupPCA(gpaTA$coords, stage, rounds = 10000, cv = TRUE, weighting = FALSE)
plot(bwgPCA_stage$Scores[,1],bwgPCA_stage$Scores[,2], col=stage, asp=1, xlab="bwgPC 1",ylab="bwgPC 2")
legend('topright', legend = levels(stage), col = 1:4, cex = 0.8, pch = 1)
measure_cols <- colnames(df_NoLA[,21:33])
df_NoLA <-  df_NoLA  %>%
mutate(across(all_of(measure_cols),
~ log(.x/exp(mean(log(.x)))),
.names = "shape_ratio_{.col}"))
#df_NoLA[,7:19]
#df_NoLA[,39:51],
#f_NoLA[,21:33]
pca<- prcomp(df_NoLA[,21:33],
center = TRUE,
scale. = TRUE)
library(ggfortify)
pca.plot <- autoplot(pca,
data = df_NoLA,
colour = 'stage')
pca.plot
fviz_contrib(pca, choice = "var", axes = 1, top = 10)
fviz_contrib(pca, choice = "var", axes = 2, top = 10)
fviz_contrib(pca, choice = "var", axes = 3, top = 10)
# Custom function for row-wise geometric mean
rowGeometricMeans <- function(data, na.rm = TRUE) {
exp(rowMeans(log(data), na.rm = na.rm))
}
df_NoLA <- df_NoLA %>%
mutate(t_centroid = rowGeometricMeans(pick(all_of(measure_cols)), na.rm = TRUE))
df_plot <-df_NoLA %>%
mutate(
resPC1 = pca$x[, 1])
ggplot(df_plot, aes(x = t_centroid, y = resPC1, color = stage)) +
geom_point() +
theme_classic() + labs(x = "size", y = "PC1 score")
knitr::opts_chunk$set(echo = TRUE)
