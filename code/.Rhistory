source("data_import.R")
source("PA_measurement.R")
source("TA_measurement.R")
source("OA_measurement.R")
library("geomorph")
library("dplyr")
options(rgl.useNULL=TRUE)
library("rgl")
library("tidyverse")
library("gtools")
library(lubridate)
library(gridExtra)
library(factoextra)
library(ggplot2)
library(clustvarsel)
library(mclust)
library(ggpubr)
library(svglite)
df <- readRDS("D:/202512-dev-seq-analyses/data/20C-202509-dev-seq-v5.rds")
# convert the lm to matrix for each file.
specs_list <- df %>%
group_by(temp, biorep,ind, plane, file) %>%
group_map(~ {
id <- paste(.y$temp,.y$biorep, .y$ind, .y$plane, .y$file, sep = "_")
# Create a sub-list for this specific identifier
spec <- list(
matrix = as.matrix(.x[, c("X", "Y")]),
metadata = as.list(.y)
)
setNames(list(spec), id)
}) %>%
flatten()
# 1. missing 1 landmark
t <- c(4607.161391, 2099.636741)
specs_list[["20_202509-dev-seq_11_TA_1007-TA-2.csv"]][["matrix"]] <- rbind(specs_list[["20_202509-dev-seq_11_TA_1007-TA-2.csv"]][["matrix"]], t)
rownames(specs_list[["20_202509-dev-seq_11_TA_1007-TA-2.csv"]][["matrix"]]) <- NULL
# 2. 1 csv has . instead of - between plane and date
specs_list[["20_202509-dev-seq_2_OA_1011.OA-1X.csv"]][["metadata"]][["file"]] <- "1011-OA-1X.csv"
# add lm 10 in the TA plane
specs_list<-add_lm10(specs_list)
palette1 <- c("#343434","#A3CEF1","#3880ba","#224f73","#000000","#CCCAC2","#837D72","#ede7da")
measurement_accumulator <- list()
for (id in names(specs_list)) {
# 1. Extract components correctly
spec   <- specs_list[[id]]
mat    <- spec$matrix
plane  <- spec$metadata$plane
ind    <- spec$metadata$ind
temp <- spec$metadata$temp
biorep <- spec$metadata$biorep
file <- spec$metadata$file
# 2. Initialize a placeholder for this specific iteration's results
res <- tibble()
# 3. Apply custom "Design" logic
if (plane == "PA") {
res <- tibble(
measure_name = c("ALO", "AW", "WAE", "ATCL"),
value = c(ALO_fun(mat), AW_fun(mat), WAE_fun(mat), ATCL_fun(mat))
)
} else if (plane == "TA") {
res <- tibble(
measure_name = c("PL", "BL", "TCL", "LTM", "LL", "TABW"),
value = c(PL_fun(mat), BL_fun(mat), TCL_fun(mat), LTM_fun(mat), LL_fun(mat), TABW_fun(mat))
)
} else if (plane == "OA") {
res <- tibble(
measure_name = c("TBL", "PW", "ATAC", "AEAC"),
value = c(TBL_fun(mat), PW_fun(mat), ATAC_fun(mat), AEAC_fun(mat))
)
}
# 4. Add metadata and store in accumulator
# Only add if we actually generated results
if (nrow(res) > 0) {
measurement_accumulator[[id]] <- res %>%
mutate(
sample_id = str_remove(file, "-.*"),
ind = ind,
plane = plane,
temp = temp,
biorep = biorep
)
}
}
# 5. Bind into one large dataframe
df_lm <- bind_rows(measurement_accumulator)
df_lm <- df_lm %>% mutate(
# Convert from microns (or current unit) to mm
value = value / 1000
)
df_onlyLA <- df_lm %>% group_by(measure_name) %>% filter(measure_name %in% c("LL", "LTM")) %>% ungroup()
ggplot(df_onlyLA,aes(x=sample_id, y = value, color = measure_name))+
geom_point(size = 1) +
theme_classic() +
scale_fill_manual(values = palette1)
df_lm <- df_lm  %>%
mutate(
value = case_when(
sample_id %in% c("0905", "0907", "0909", "0911", "0913","0915") & measure_name %in% c("LL", "LTM","ALO", "AW") ~ NA,
sample_id %in% c( "0917", "0919") &  measure_name %in% c("ALO", "AW") ~ NA,
TRUE ~ value
)
)
#df_lm <- drop_na(df_lm)
#create a new column with log value
df_lm <- df_lm %>% mutate(log_value = log(value))
df_BL <- df_lm %>%
# 1. Create a lookup of just the BL values
left_join(
df_lm %>%
filter(measure_name == "BL") %>%
select(sample_id, ind, bl_value = value, bl_log = log_value),
by = c("sample_id","ind")
) %>%
filter(!(measure_name %in% c("BL")))
# filter(!(measure_name %in% c("BL","PL","TABW")))
p <- ggplot(df_BL, aes(x = bl_log, y = log_value, color = measure_name)) +
geom_point(size = 1) +
geom_smooth(method = "lm", se = FALSE, linewidth = 1) +
theme_classic() +
scale_color_viridis_d()+ scale_fill_hue(c = 70)
p
ggsave("D:/202512-dev-seq-analyses/fig/dev.svg", width=10, height=8)
p <- p + stat_regline_equation(aes(label =  paste(..eq.label.., ..rr.label.., sep = "~~~~")))
p
measurement <- c("AEAC","ATAC")
oa <- df_BL %>%
filter(measure_name %in% measurement) %>% # Only keeps these three
ggplot(aes(x = bl_log, y = log_value, color = measure_name)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
theme_classic() +scale_color_manual(values = c("AEAC" = "#787A7D", "ATAC" = "#393D3F"))+ stat_regline_equation(aes(label =  paste(..eq.label.., ..rr.label.., sep = "~~~~")))
oa
measurement <- c("TABW","TCL","WAE","PW")
fig_total <- df_BL %>%
filter(measure_name %in% measurement) %>% # Only keeps these three
ggplot(aes(x = bl_log, y = log_value, color = measure_name)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
theme_classic() +scale_color_manual(values = c("TABW" = "#546A7B", "TCL" = "#8FABB7", "WAE" = "#384F57", "PW" = "#8DB2F9"))+ stat_regline_equation(aes(label =  paste(..eq.label.., ..rr.label.., sep = "~~~~")))
measurement <- c("LL","LTM")
fig_lobe <- df_BL %>%
filter(measure_name %in% measurement) %>% # Only keeps these three
ggplot(aes(x = bl_log, y = log_value, color = measure_name)) +
geom_point() +
geom_smooth(method="lm") +
theme_classic() +scale_color_manual(values = c("LL" = "#627F7F", "LTM" = "#94A29C"))+
stat_regline_equation(aes(label =  paste(..eq.label.., ..rr.label.., sep = "~~~~")))
fig_lobe
measurement <- c("ALO","AW")
fig_auricle <- df_BL %>%
filter(measure_name %in% measurement) %>% # Only keeps these three
ggplot(aes(x = bl_log, y = log_value, color = measure_name)) +
geom_point() +
geom_smooth(method = "lm") +
theme_classic() +scale_color_manual(values = c("ALO" = "#C6C5B9", "AW" = "#A29F90")) + stat_regline_equation(aes(label =  paste(..eq.label.., ..rr.label.., sep = "~~~~")))
#fig_total
fig_auricle
dev<-ggarrange(fig_total, oa, fig_auricle, fig_lobe, ncol = 2, nrow = 2)
ggsave(file="D:/202512-dev-seq-analyses/fig/dev.svg", plot=dev)
