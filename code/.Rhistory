scale_color_brewer(palette = "Set1") +
labs(
title = "Lobate Development Rate Over Time",
x = "Experimental Day",
y = "% Lobate in survived population",
color = "Temperature"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "bottom"
)
temp_plot
temp_plot
temp_plot <-ggplot(df_daily_summary_detailed, aes(x = exp_day, y = pct_lobate, color = factor(temp))) +
# Single solid trendline per temperature
geom_line(linewidth = 1.3) +
# Data points for each sampling day
geom_point(size = 3) +
# Formatting appearance
scale_color_brewer(palette = "Set1") +
labs(
title = "Cydippid-to-lobate Rate Over Time",
x = "Experimental Day",
y = "% Lobate in survived population",
color = "Temperature"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "bottom"
)
temp_plot
temp_plot
